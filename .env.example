# FusionWeb 完整系统生产配置
COMPOSE_PROJECT_NAME=fusionweb

# 六个镜像的公共前缀。将 your-acr-namespace 替换为阿里云 ACR 杭州区命名空间。
# 实际仓库名为 fusionweb-api/web/worker/postgres/redis/minio。
FUSIONWEB_IMAGE_PREFIX=registry.cn-hangzhou.aliyuncs.com/your-acr-namespace/fusionweb
FUSIONWEB_VERSION=0.1.0

# 仅源码构建覆盖层使用；生产部署不会现场编译。
FUSIONWEB_GO_PROXY=https://goproxy.cn,direct
FUSIONWEB_DEBIAN_MIRROR=http://deb.debian.org/debian
FUSIONWEB_DEBIAN_SECURITY_MIRROR=http://deb.debian.org/debian-security

# Web
FUSIONWEB_HTTP_PORT=8756
FUSIONWEB_HTTPS_PORT=8988
FUSIONWEB_BASIC_AUTH=true
FUSIONWEB_BASIC_USER=admin
FUSIONWEB_BASIC_PASS=
FUSIONWEB_JWT_SECRET=
FUSIONWEB_TITLE=FusionWeb

# PostgreSQL
POSTGRES_DB=fusionweb
POSTGRES_USER=fusionweb
POSTGRES_PASSWORD=change-me-postgres
FUSIONWEB_PG_MAX_OPEN=50
FUSIONWEB_PG_MAX_IDLE=10

# Redis
FUSIONWEB_REDIS_PASSWORD=change-me-redis
FUSIONWEB_REDIS_DB=0
FUSIONWEB_REDIS_PREFIX=fusionweb

# MinIO
FUSIONWEB_MINIO_ACCESS_KEY=fusionweb
FUSIONWEB_MINIO_SECRET_KEY=change-me-minio-secret
FUSIONWEB_MINIO_BUCKET=fusionweb
FUSIONWEB_MINIO_REGION=us-east-1
FUSIONWEB_MINIO_PUBLIC_URL=

# Worker
FUSIONWEB_WORKER_KEY=change-me-worker-key
FUSIONWEB_WORKER_NAME=default-worker
FUSIONWEB_WORKER_CONCURRENCY=5

# 主 Compose 默认不映射基础设施端口。远程 Worker 直连时叠加 docker-compose.remote-access.yaml。
FUSIONWEB_INFRA_BIND=127.0.0.1
FUSIONWEB_PG_PORT=5432
FUSIONWEB_REDIS_PORT=6379
FUSIONWEB_MINIO_PORT=9000
FUSIONWEB_MINIO_CONSOLE_PORT=9001
FUSIONWEB_WORKER_EXTERNAL_PG_DSN=
FUSIONWEB_WORKER_EXTERNAL_REDIS_ADDR=
FUSIONWEB_WORKER_EXTERNAL_MINIO_ENDPOINT=
