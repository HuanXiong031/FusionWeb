# FusionWeb × DeepSeek Harness（DSH）
# 保持 DSH 的默认安装形态：只装 @deepseek-ai/dsh，不注入任何自定义 settings/profile。
# 模型凭据与偏好由使用者在 DSH 自带 Web 界面里配置（持久化在 DSH_HOME 卷中）。
FROM node:22-bookworm-slim

RUN npm install -g @deepseek-ai/dsh@latest \
    && npm cache clean --force

# ── 复刻 1Panel 官方应用的两处 DSH 补丁 ────────────────────────────────
# 目的：让「设置 / 模型」在“经认证的反向代理”之后，于远程浏览器（含 iframe）中可用。
#  ① 连接层放行：由前置反代承担认证（对应 1Panel 的 ONEPANEL_DSH_AUTH_PROXY）
#  ② 设置页可用：前端在反代注入的 globalThis.__DSH_AUTHENTICATED_SETTINGS__ 为 true 时启用 host 持久化
# 构建期断言：目标代码不存在就让构建失败，避免“静默出包但功能失效”。
RUN set -eux; \
    CONN="/usr/local/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-client-connection/lib/index.js"; \
    SUI="/usr/local/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-client-ui-settings/lib/client.js"; \
    grep -q 'isAuthenticated(request) {' "$CONN"; \
    sed -i 's/isAuthenticated(request) {/isAuthenticated(request) { if (process.env.DSH_AUTH_PROXY === "1") return true;/' "$CONN"; \
    grep -q 'DSH_AUTH_PROXY' "$CONN"; \
    grep -q 'isLoopback ? "host" : "memory"' "$SUI"; \
    sed -i 's/isLoopback ? "host" : "memory"/isLoopback || globalThis.__DSH_AUTHENTICATED_SETTINGS__ === true ? "host" : "memory"/g' "$SUI"; \
    grep -q '__DSH_AUTHENTICATED_SETTINGS__' "$SUI"; \
    node -e "console.log('patched DSH version: ' + require('/usr/local/lib/node_modules/@deepseek-ai/dsh/package.json').version)"

ENV DSH_HOME=/root/.dsh
ENV DSH_PORT=8990
# 前置反代已做认证（FusionWeb nginx Basic Auth），DSH 侧放行
ENV DSH_AUTH_PROXY=1

COPY docker/dsh-entrypoint.sh /usr/local/bin/dsh-entrypoint
COPY docker/dsh-proxy.mjs /usr/local/bin/dsh-proxy.mjs
COPY docker/dsh-ensure-bundle.mjs /usr/local/bin/dsh-ensure-bundle.mjs
COPY docker/dsh-plugins/fusionweb-tools /opt/fusionweb-tools
RUN chmod +x /usr/local/bin/dsh-entrypoint

EXPOSE 8990

ENTRYPOINT ["/usr/local/bin/dsh-entrypoint"]
