# FusionWeb × DeepSeek Harness（DSH）
# 保持 DSH 的默认安装形态：只装 @deepseek-ai/dsh，不注入任何自定义 settings/profile。
# 模型凭据与偏好由使用者在 DSH 自带 Web 界面里配置（持久化在 DSH_HOME 卷中）。
FROM node:22-bookworm-slim

RUN npm install -g @deepseek-ai/dsh@latest pnpm \
    && npm cache clean --force

# ── 复刻 1Panel 官方应用的两处 DSH 补丁 ────────────────────────────────
# 目的：让「设置 / 模型」在“经认证的反向代理”之后，于远程浏览器（含 iframe）中可用。
#  ① 连接层放行：由前置反代承担认证（对应 1Panel 的 ONEPANEL_DSH_AUTH_PROXY）
#  ② 设置页可用：前端在反代注入的 globalThis.__DSH_AUTHENTICATED_SETTINGS__ 为 true 时启用 host 持久化
# 构建期断言：目标代码不存在就让构建失败，避免“静默出包但功能失效”。
RUN set -eux; \
    CONN="/usr/local/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-client-connection/lib/index.js"; \
    SUI="/usr/local/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-client-ui-settings/lib/client.js"; \
    grep -q 'isAuthenticated(request) {' "$CONN"; \
    sed -i 's/isAuthenticated(request) {/isAuthenticated(request) { if (process.env.DSH_AUTH_PROXY === "1") return true;/' "$CONN"; \
    grep -q 'DSH_AUTH_PROXY' "$CONN"; \
    grep -q 'isLoopback ? "host" : "memory"' "$SUI"; \
    sed -i 's/isLoopback ? "host" : "memory"/isLoopback || globalThis.__DSH_AUTHENTICATED_SETTINGS__ === true ? "host" : "memory"/g' "$SUI"; \
    grep -q '__DSH_AUTHENTICATED_SETTINGS__' "$SUI"; \
    node -e "console.log('patched DSH version: ' + require('/usr/local/lib/node_modules/@deepseek-ai/dsh/package.json').version)"

ENV DSH_HOME=/root/.dsh
ENV DSH_PORT=8990
# 前置反代已做认证（FusionWeb nginx Basic Auth），DSH 侧放行
ENV DSH_AUTH_PROXY=1

# ── 运行期工具 ────────────────────────────────────────────────────────
# git：DSH 插件管理（Redteam Manager 走 `dsh plugin` → pnpm）解析 github: 依赖需要它
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# ── 预置 dsh-redteam-model（红队十模式 + 十七插件，vendor 固定 commit） ──
# 目的：镜像自包含，容器启动不依赖 GitHub/网络；版本可复现（固定 commit）。
# 参考：https://github.com/SeaOf0/dsh-redteam-model （MIT）
ARG REDTEAM_REPO=https://github.com/SeaOf0/dsh-redteam-model
ARG REDTEAM_REF=6d2554c8a6b9e47bafd78b5b6e0d5896cfbf7b8e
RUN git clone --filter=blob:none --no-checkout "$REDTEAM_REPO" /opt/dsh-redteam \
    && cd /opt/dsh-redteam \
    && git checkout "$REDTEAM_REF" \
    && rm -rf .git \
    && test -f /opt/dsh-redteam/cordis.patch.yml
# 让它能解析 DSH 及其依赖（等价于被装进 DSH 的 node_modules 环境），无需运行时 pnpm 安装
RUN set -eu; \
    DSH_NM=/usr/local/lib/node_modules/@deepseek-ai/dsh/node_modules; \
    mkdir -p /opt/dsh-redteam/node_modules/@deepseek-ai; \
    for p in "$DSH_NM"/@deepseek-ai/*; do ln -sfn "$p" /opt/dsh-redteam/node_modules/@deepseek-ai/; done; \
    for p in "$DSH_NM"/*; do \
      [ "$(basename "$p")" = "@deepseek-ai" ] && continue; \
      ln -sfn "$p" /opt/dsh-redteam/node_modules/; \
    done; \
    ls /opt/dsh-redteam/node_modules/@deepseek-ai/dsh-settings >/dev/null
# 插件之间存在互相引用（例如 dsh-hunter 导入 @dsh-external/dsh-redteam-results），
# 因此把全部插件也链进包自身的 node_modules，保证无论启用哪些子集都能解析。
RUN set -eu; \
    mkdir -p /opt/dsh-redteam/node_modules/@dsh-external; \
    for p in /opt/dsh-redteam/plugins/*; do \
      [ -d "$p" ] || continue; \
      ln -sfn "$p" /opt/dsh-redteam/node_modules/@dsh-external/$(basename "$p"); \
    done; \
    ls /opt/dsh-redteam/node_modules/@dsh-external | wc -l

# 默认启用的红队插件（宿主平面；可用环境变量覆盖，无需重建镜像）
# 不含 dsh-scanner-tools（扫描改由 FusionWeb 承担）与需要外部 CLI/MCP 的插件。
ENV DSH_REDTEAM_PLUGINS="dsh-stage-gate dsh-route-boost dsh-sec-enforce dsh-refusal-guard dsh-trace-vault dsh-auto-advance dsh-redteam-results dsh-campaign-memory dsh-mode-group dsh-session-pulse dsh-attack-atlas dsh-mcp-studio dsh-hunter dsh-webshell-mgr"

COPY docker/dsh-entrypoint.sh /usr/local/bin/dsh-entrypoint
COPY docker/dsh-proxy.mjs /usr/local/bin/dsh-proxy.mjs
COPY docker/dsh-bridge.mjs /usr/local/bin/dsh-bridge.mjs
COPY docker/dsh-ensure-bundle.mjs /usr/local/bin/dsh-ensure-bundle.mjs
COPY docker/dsh-plugins/fusionweb-tools /opt/fusionweb-tools
COPY docker/dsh-plugins/fusionweb-approval /opt/fusionweb-approval
COPY docker/dsh-redteam-mcp.patch.yml /opt/dsh-redteam/fusionweb-mcp.patch.yml
RUN chmod +x /usr/local/bin/dsh-entrypoint \
    && mkdir -p /workspace

EXPOSE 8990

ENTRYPOINT ["/usr/local/bin/dsh-entrypoint"]
