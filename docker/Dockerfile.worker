# syntax=docker/dockerfile:1.7

# FusionWeb Worker 本体
#
# 注意：扫描/审计类 CLI（nmap/masscan/naabu/httpx/nuclei/subfinder/dnsx/ffuf）
# 已统一收敛到 fusionweb-tools 镜像，本镜像不再内置它们：
#   * 运行期通过 FUSIONWEB_TOOLKIT_URL 把工具调用转发给 toolkit（见 backend/engine/cli/remote.go）；
#   * toolkit 不可用时才回退本机（本镜像已无这些二进制，因此需保证 toolkit 正常运行）。
# 仅保留 worker 自身需要的 chromium（网页截图）。
FROM golang:1.25-bookworm AS worker-builder
WORKDIR /src
ARG GOPROXY=https://goproxy.cn,https://proxy.golang.org,direct
ENV GOPROXY=${GOPROXY}
RUN printf '%s\n' '#!/bin/sh' 'n=0' 'until "$@"; do n=$((n+1)); if [ "$n" -ge 5 ]; then echo "重试 5 次仍失败: $*" >&2; exit 1; fi; echo "第 $n 次失败，5 秒后重试: $*" >&2; sleep 5; done' > /usr/local/bin/retry && chmod +x /usr/local/bin/retry
# 说明：Go 模块代理偶发断流（stream error: INTERNAL_ERROR）会让整次构建失败，
# 且 GOPROXY 的降级链只在模块缺失(404)时生效、对断流无效，故统一用 retry 包装。
COPY go.mod go.sum ./
COPY backend/engine/lib/gonmap/go.mod backend/engine/lib/gonmap/go.sum ./backend/engine/lib/gonmap/
COPY backend/engine/lib/dnsx/go.mod backend/engine/lib/dnsx/go.sum ./backend/engine/lib/dnsx/
COPY backend/engine/lib/gologger/go.mod backend/engine/lib/gologger/go.sum ./backend/engine/lib/gologger/
COPY backend/engine/lib/httpx/go.mod backend/engine/lib/httpx/go.sum ./backend/engine/lib/httpx/
COPY backend/engine/lib/nuclei/go.mod backend/engine/lib/nuclei/go.sum ./backend/engine/lib/nuclei/
RUN --mount=type=cache,target=/go/pkg/mod retry go mod download
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    retry env CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/fusionweb-worker ./worker

# 扫描 CLI 在 CI 构建镜像时编译，部署机器只拉取镜像。
FROM golang:1.26-bookworm AS scanner-tool-base
ARG GOPROXY=https://goproxy.cn,https://proxy.golang.org,direct
ENV GOPROXY=${GOPROXY}
RUN printf '%s\n' '#!/bin/sh' 'n=0' 'until "$@"; do n=$((n+1)); if [ "$n" -ge 5 ]; then echo "重试 5 次仍失败: $*" >&2; exit 1; fi; echo "第 $n 次失败，5 秒后重试: $*" >&2; sleep 5; done' > /usr/local/bin/retry && chmod +x /usr/local/bin/retry
# 说明：Go 模块代理偶发断流（stream error: INTERNAL_ERROR）会让整次构建失败，
# 且 GOPROXY 的降级链只在模块缺失(404)时生效、对断流无效，故统一用 retry 包装。
ENV GOSUMDB=off
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git gcc libc6-dev libpcap-dev \
    && rm -rf /var/lib/apt/lists/*

FROM debian:bookworm-slim
ARG DEBIAN_MIRROR=http://deb.debian.org/debian
ARG DEBIAN_SECURITY_MIRROR=http://deb.debian.org/debian-security
RUN sed -i \
      -e "s|http://deb.debian.org/debian|${DEBIAN_MIRROR}|g" \
      -e "s|http://security.debian.org/debian-security|${DEBIAN_SECURITY_MIRROR}|g" \
      -e "s|http://deb.debian.org/debian-security|${DEBIAN_SECURITY_MIRROR}|g" \
      /etc/apt/sources.list.d/debian.sources \
    && rm -f /etc/apt/apt.conf.d/docker-clean \
    && printf 'Binary::apt::APT::Keep-Downloaded-Packages "true";\n' > /etc/apt/apt.conf.d/keep-cache
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates tzdata dumb-init iputils-ping \
       chromium fonts-noto-cjk
WORKDIR /app
COPY --from=worker-builder /out/fusionweb-worker /usr/local/bin/fusionweb-worker
COPY data /opt/fusionweb-data
COPY docker/worker-entrypoint.sh /usr/local/bin/fusionweb-worker-entrypoint
RUN chmod +x /usr/local/bin/fusionweb-worker-entrypoint \
    && chromium --version
ENV TZ=Asia/Shanghai
ENV CHROME_BIN=/usr/bin/chromium
ENV FUSIONWEB_DATA_DIR=/app/data
ENTRYPOINT ["dumb-init", "--", "/usr/local/bin/fusionweb-worker-entrypoint"]
CMD ["fusionweb-worker"]

